// @polsia:user-owned — CARI Forge control plane schema. Tracks typed
// structured handoffs across 5 lifecycle stages (Discovery → Readiness →
// Workflow → Governance → SoftwareBuild) with attribution, gates, evidence
// trail, objections, bounded external tool actions, and an append-only audit
// log. FKs are scalars (no @relation to User, which lives in the framework-
// owned auth.prisma); cascade semantics live in app code under /api/forge/*.

enum MissionStatus {
  Draft
  InDiscovery
  InReadiness
  InWorkflow
  InGovernance
  InBuild
  AwaitingApproval
  Paused
  Blocked
  Rejected
  Completed
  WalkedAway
  RolledBack
}

enum StageName {
  Discovery
  Readiness
  Workflow
  Governance
  SoftwareBuild
}

enum ApprovalDecision {
  Approve
  // R4 (mission pipeline rebuild): the reference platform's governance
  // schema supports a 4th outcome for exactly this case — a named control
  // attached to an otherwise-Approve decision. Client derives this value
  // from "Approve" + non-empty Controls text; it is never a raw dropdown
  // choice (see APPROVAL_DECISION_VALUES / isApproveDecision in forge.ts).
  ApproveWithControls
  Return
  Refuse
}

enum ObjectionResolution {
  Overruled
  CarriedForward
  OwnerResolved
  Closed
}

enum EvidenceKind {
  Text
  File
  Url
  TestRun
  Attestation
  ExternalRef
}

enum ToolScope {
  Internal
  External
}

enum ToolDecision {
  Approved
  Denied
}

model Mission {
  id                  String        @id @default(cuid())
  slug                String        @unique
  name                String
  intake              String
  normalizedNeed      String
  status              MissionStatus @default(Draft)
  currentStageIndex   Int           @default(0)
  currentDraftVersion Int?
  confidence          Float         @default(0)
  pausedAt            DateTime?
  completedAt         DateTime?
  rolledBackAt        DateTime?
  previousStatus      MissionStatus?
  intakeStructured    Json?
  releaseReadoutAt    DateTime?
  createdById         String
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  domainTags          String[]
  // UX review C1 (wireframe v2): a mission converted from a public brief
  // keeps its Lead id forever, so the CF-XXXX reference survives into the
  // governed pipeline. Scalar FK by module convention (see header).
  sourceLeadId        String?

  @@index([createdById])
  @@index([status])
  @@index([sourceLeadId])
}

model StageHandoff {
  id                        String     @id @default(cuid())
  missionId                 String
  stage                     StageName
  version                   Int
  parentVersionId           String?
  correctionOfId            String?
  supersededById            String?
  replayOfMissionId         String?
  payload                   Json
  confidence                Float
  missingEvidence           Json
  toolRefs                  String[]
  producedByToolActionId    String?
  gateIndexThatApproves     Int
  invalidationReasonCode    String?
  createdById               String
  createdAt                 DateTime   @default(now())

  @@index([missionId, stage, version])
  @@index([missionId, stage])
  @@index([missionId, createdAt])
}

// Async, chunked SoftwareBuild generation (2026-09-06, real user-reported
// production incident: the single synchronous AI call this stage used to
// make is deliberately sized for a 150s run — the file/spec generation
// genuinely takes that long for a real MVP — but this Vercel project is on
// the Hobby plan, which kills any serverless function at 60s. Choice made
// explicitly by the user over upgrading to Pro: stay on Hobby, make the
// generation itself resumable instead. One HTTP request now does ONE
// bounded unit of work (plan the file list, or generate one file's
// content, or finalize) well under 60s, persists progress here, and
// returns; the client polls this job forward step by step until Done.
// See business/forge/build-job.ts for the state machine this drives.
model SoftwareBuildJob {
  id            String                 @id @default(cuid())
  missionId     String
  status        SoftwareBuildJobStatus @default(Planning)
  // The file list (path + one-line purpose, no content yet) and the
  // technical-spec fields, produced by the single "planning" step.
  // Null until that step completes.
  plan          Json?
  // Files completed so far — grows by one GeneratedFileV4 {path, content}
  // per "generating" step, in plan-list order.
  files         Json                   @default("[]")
  nextFileIndex Int                    @default(0)
  error         String?
  createdById   String
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([missionId, createdAt])
}

enum SoftwareBuildJobStatus {
  Planning
  Generating
  Finalizing
  Done
  Failed
}

// Real user report (2026-09-06): a completed mission's generated files and
// technical spec existed in StageHandoff.payload all along, but nothing in
// the UI ever rendered them — "the build is complete however i dont see
// the files and spec as expected." Also asked for a real "MVP to
// production" roadmap with concrete next steps, which is more than the
// existing deploymentNotes field (a short paragraph) provides.
//
// This table caches that roadmap (an AI-generated document, one bounded
// call — see business/forge/deliverables.ts) keyed by mission + kind, so:
// (1) it's generated once, not re-generated on every page view or every
// download, and (2) it persists in the database, not browser storage — the
// explicit ask ("make sure the download remains when the person logs in
// and out and comeback") is satisfied by this being server-authoritative,
// not a client-side blob URL. @@unique enforces "generate once per kind".
model MissionDeliverable {
  id        String   @id @default(cuid())
  missionId String
  kind      String
  content   Json
  createdAt DateTime @default(now())

  @@unique([missionId, kind])
}

model Approval {
  id                  String           @id @default(cuid())
  missionId           String
  gateIndex           Int
  stageHandoffId      String
  approverUserId      String?
  decision            ApprovalDecision
  // R4: free-text controls attached to an ApproveWithControls decision —
  // "adding any turns Approve into approve-with-controls" (reference
  // platform's own ApprovalForm copy). Null for every other decision.
  controls            String?
  reasonCode          String
  reasonText          String
  supersedesApprovalId String?
  replayOfApprovalId  String?
  at                  DateTime         @default(now())

  @@unique([missionId, gateIndex, stageHandoffId])
  @@index([missionId, gateIndex])
  @@index([missionId, at])
}

model Objection {
  id              String              @id @default(cuid())
  missionId       String
  stageHandoffId  String
  raisedByRole    String
  text            String
  evidenceRefId   String?
  raisedAt        DateTime            @default(now())
  resolution      ObjectionResolution?
  resolutionText  String?

  @@index([missionId, raisedAt])
}

model EvidenceItem {
  id                       String        @id @default(cuid())
  missionId                String
  attachedToStageHandoffId String?
  kind                     EvidenceKind
  ref                      String
  label                    String
  capturedAt               DateTime      @default(now())
  capturedById             String

  @@index([missionId, capturedAt])
  @@index([missionId])
}

// Mission-evidence counterpart to LeadAttachment (see leads.prisma) — same
// reasoning: stored directly in Postgres (bytea) rather than a separate
// file-storage provider, no new infrastructure needed at pilot scale. Used
// by the chat-based project intake's document attachment (attached to the
// mission right after it's created — no mission exists yet during the
// chat itself) and by any other kind='File' evidence item. One EvidenceItem
// row (kind='File', ref=this row's id) is created alongside each upload;
// this table holds only the bytes.
model EvidenceFile {
  id         String   @id @default(cuid())
  missionId  String
  filename   String                        // original filename, as uploaded — display only, never used as a path
  mimeType   String
  sizeBytes  Int
  data       Bytes                         // the file itself
  createdAt  DateTime @default(now())

  @@index([missionId])
}

model ToolAction {
  id                       String        @id @default(cuid())
  missionId                String
  tool                     String
  scope                    ToolScope
  payload                  Json
  requestedById            String
  decidedById              String?
  decision                 ToolDecision?
  decisionReasonCode       String?
  requiresGateApproval     Boolean       @default(false)
  approvedGateIndex        Int?
  decidedAt                DateTime?
  rejectedAt               DateTime?
  executedAt               DateTime?
  resultRef                String?
  rollbackOfToolActionId   String?
  producedStageHandoffId   String?
  createdAt                DateTime      @default(now())

  @@index([missionId, createdAt])
  @@index([missionId])
}

model MissionAudit {
  id                 String   @id @default(cuid())
  missionId          String
  event              String
  payload            Json
  at                 DateTime @default(now())
  actorId            String?
  missionVersionAtEvent Int

  @@index([missionId, at])
}
