//
// better-auth (v1.6.x) core models for the Prisma adapter — verbatim shape
// emitted by `npx @better-auth/cli generate`, plus admin plugin fields on
// User/Session. Self-contained: relations exist ONLY among these four models;
// NO @relation to any other module's models.
// Datasource + generator live in prisma/schema/_base.prisma (framework-owned by
// the template). Do NOT redeclare them here.
//
// emailAndPassword is enabled in src/lib/auth.ts — the password lives on Account.
// The admin plugin is enabled in src/lib/auth.ts and adds role/ban metadata.
// @@map keeps the physical table names lowercase, exactly what better-auth's adapter queries.
//
// HAND-EDITED (no polsia CLI / module registry reachable from this environment
// to regenerate this file): the installed `better-auth` package is 1.7.1, whose
// core schema (@better-auth/core/dist/db/schema/account.mjs + db/get-tables.mjs)
// now requires a required `issuer` string field on Account plus a unique
// (issuer, accountId) index — used to key local vs. OAuth accounts. Every
// account.create() call (including plain email/password sign-up) sets it, so
// its absence here throws `Unknown argument issuer` and 500s. Added below to
// keep this framework-owned file in sync with its own framework's currently
// installed version — not a customization. See prisma/migrations/20260826120000_add_account_issuer.

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  role          String?   @default("user")
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  impersonatedBy String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  issuer                String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@unique([issuer, accountId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}
