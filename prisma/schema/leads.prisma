// @polsia:user-owned — Lead model for the cariforge.com front-door funnel.
// One requirements submission per row from a regulated buyer landing on /.
// Captures what they want to build, an optional reply-to email, when it
// arrived, and whether the best-effort owner-email notification fired.

model Lead {
  id          String           @id @default(cuid())
  brief       String                       // required requirements text (20-4000 chars post-trim, per contracts/leads.ts) — no @db.VarChar cap, Prisma's plain String is Postgres text
  email       String?                      // optional — contact email back-channel
  createdAt   DateTime         @default(now())    // capture timestamp
  notifiedAt  DateTime?                    // when we successfully fired the owner email
  source      String?                      // funnel discriminator: 'home' for the front-door brief, 'walkthrough' for the procurement-grade form
  payload     String?                      // JSON-encoded structured fields for non-brief flows (e.g. walkthrough); 'brief' row keeps this null
  notes       String?                      // free-text operator note (admin-owned); null = no note yet
  attachments LeadAttachment[]
  // Explicit product decision (2026-08-29): the front-door brief's first
  // response is a real, fully-automated Discovery-agent read — no human in
  // the loop before the visitor sees it (contracts/leads.ts's LeadTriage /
  // business/business/configurator.ts's getConfiguratorResult, same call
  // already live behind the pre-signup workflow configurator). Stores the
  // full ConfiguratorResultT JSON; null means triage never ran or the
  // ANTHROPIC_API_KEY-gated call was unavailable — the confirmation UI
  // degrades to the human-review copy in that case, same convention as
  // qa-review.ts's 'unavailable' status.
  triage      Json?
  @@index([createdAt])
}

// One optional document attached to a brief, stored directly in Postgres
// (bytea) rather than a separate file-storage provider (Vercel Blob/S3) —
// no new infrastructure needed for pilot-scale volume. Capped hard at
// MAX_ATTACHMENT_BYTES (contracts/leads.ts) to stay well under Vercel's
// serverless request-body limit and keep row size sane; one attachment per
// lead, enforced app-side in the upload route, not by a DB constraint.
model LeadAttachment {
  id         String   @id @default(cuid())
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  filename   String                        // original filename, as uploaded — display only, never used as a path
  mimeType   String
  sizeBytes  Int
  data       Bytes                         // the file itself
  createdAt  DateTime @default(now())
  @@index([leadId])
}
