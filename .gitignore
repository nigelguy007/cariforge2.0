# Polsia Next.js template — gitignore (Node + Next.js + tools)

# Dependencies
node_modules/
.pnpm-store/

# Next.js
.next/
/out/
next-env.d.ts

# Production builds
/build/
/dist/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Env files: never commit .env*
# Block every .env* variant (.env, .env.local, .env.production, .env.staging, …)
# and keep only the committed .env.example documenting the shape.
.env*
!.env.example

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Testing
/coverage/

# TypeScript
*.tsbuildinfo

# Vercel
.vercel

# Polsia upgrade reconcile sidecars (never commit)
*.polsia-app-old
.claude/settings.local.json

# Session handoff notes. NEVER commit: this repo is public, and HANDOFF.md
# documents unfixed security findings against the live deployment — publishing
# it would hand an attacker a mapped route list. Committed handover docs that
# contain no live vulnerability detail belong in docs/ instead.
HANDOFF.md

# Playwright e2e (2026-09-04) — .auth/ holds real session cookies for the QA
# accounts (tests/e2e/global-setup.ts writes them). Public repo: never commit
# a live session token. playwright-report/ and test-results/ are just run
# output.
tests/e2e/.auth/
tests/e2e/.output/
playwright-report/
test-results/
