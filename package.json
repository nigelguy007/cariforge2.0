  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.13.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "4.4.0",
    "jsdom": "26.0.0",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.5.4",
    "vitest": "3.2.6"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "esbuild": "^0.28.1"
  }
